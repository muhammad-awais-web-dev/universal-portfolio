# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

# Server-side only (DO NOT expose to client)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication - Set a strong 125-character passphrase for admin access
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('base64').slice(0, 125))"
ADMIN_PASSPHRASE=your_125_character_passphrase_here


# Environment Mode - controls whether the portfolio is live or in development mode
# Set to "development" (case-insensitive) to show a coming-soon page to visitors
# Remove or set to any other value to publish the portfolio
ENVIRONMENT=development
