# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

# Server-side only (DO NOT expose to client)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication - Set a strong 125-character passphrase for admin access
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('base64').slice(0, 125))"
ADMIN_PASSPHRASE=your_125_character_passphrase_here


# Cloudinary - Get these from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Resend - Email service for contact form (https://resend.com)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_EMAIL=your_email@example.com

# Environment Mode - controls whether the portfolio is live or in development mode
# Set to "development" (case-insensitive) to show a coming-soon page to visitors
# Remove or set to any other value to publish the portfolio
ENVIRONMENT=development
